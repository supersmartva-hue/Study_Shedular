{
  "manifest_version": 3,
  "name":             "Smart Productivity — Save as Task",
  "version":          "2.1.0",
  "description":      "One-click task & study capture from YouTube, Coursera, Wikipedia and any website.",

  "permissions":      ["activeTab", "storage", "notifications", "tabs"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js":      ["content/content.js"],
      "run_at":  "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Productivity"
  },

  "options_page": "options/options.html",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
