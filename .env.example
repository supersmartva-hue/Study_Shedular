# ===== DATABASE (REQUIRED) =====
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://smartuser:smartpass@localhost:5432/smartprod

# ===== JWT AUTHENTICATION (REQUIRED) =====
# Generate with: openssl rand -base64 32
# Must be at least 16 characters, preferably 32+
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_REFRESH_SECRET=another-random-32-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== AI PROVIDERS (Optional - features degrade if missing) =====
# Google Gemini - get from https://aistudio.google.com
GEMINI_API_KEY=

# OpenAI - get from https://platform.openai.com
OPENAI_API_KEY=sk-...

# Groq - get from https://console.groq.com
GROQ_API_KEY=

# Serper Search - get from https://serper.dev
SERPER_API_KEY=

# Google Custom Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Google Books API
GOOGLE_BOOKS_API_KEY=

# Brave Search API
BRAVE_API_KEY=

# ===== FILE STORAGE =====
# Cloudinary for image uploads - get from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== PUSH NOTIFICATIONS =====
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@yourdomain.com

# ===== APP CONFIGURATION =====
CLIENT_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# ===== FRONTEND =====
# goes in apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_KEY=your-vapid-public-key

